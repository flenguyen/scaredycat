{
  "manifest_version": 3,
  "name": "Scaredy Cat",
  "version": "2.1.2",
  "minimum_chrome_version": "137",
  "homepage_url": "https://www.scaredycat.app",
  "description": "Protects you from horror content while browsing. Because not everyone wants to see scary stuff! 🙀",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "offscreen",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.imdb.com/*",
        "*://*.rottentomatoes.com/*",
        "*://*.themoviedb.org/*",
        "*://*.letterboxd.com/*",
        "*://*.shudder.com/*",
        "*://*.netflix.com/*",
        "*://*.hulu.com/*",
        "*://*.disneyplus.com/*",
        "*://*.hbomax.com/*",
        "*://*.max.com/*",
        "*://*.primevideo.com/*",
        "*://*.fandango.com/*"
      ],
      "js": [
        "content/early-init.js"
      ],
      "css": [
        "styles/early-block.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "background/image-key.js",
        "content/scoring-core.js",
        "content/genre-signal.js",
        "content/element-state.js",
        "content/ui-kit.js",
        "content/site-adapters.js",
        "content/cards.js",
        "content/detector.js",
        "content/feedback-ui.js",
        "content/blocker.js",
        "content/observer.js",
        "content/ml-bridge.js",
        "content/youtube-preview-guard.js",
        "content/picker.js",
        "content/content.js"
      ],
      "run_at": "document_end",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "exclude_matches": [
        "*://*.loom.com/*",
        "*://*.loomcdn.com/*",
        "*://*.zoom.us/*",
        "*://*.zoom.com/*",
        "*://meet.google.com/*",
        "*://teams.microsoft.com/*",
        "*://teams.live.com/*",
        "*://*.webex.com/*",
        "*://*.slack.com/*",
        "*://*.discord.com/*",
        "*://*.discordapp.com/*",
        "*://*.twitch.tv/*",
        "*://*.whereby.com/*",
        "*://*.around.co/*",
        "*://*.screen.so/*",
        "*://*.cal.com/*",
        "*://*.calendly.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Scaredy Cat - Horror Content Blocker"
  }
}
