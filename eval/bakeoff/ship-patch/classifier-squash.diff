+/**
+ * Squash: the whole image resized straight to the model's square input
+ * (no crop), so the processor has nothing left to resize.
+ */
+async function decodeSquash(blob) {
+  const size = processor.image_processor.size;
+  const S = typeof size === 'number' ? size : (size.shortest_edge ?? size.height);
+  const bitmap = await createImageBitmap(blob, { resizeWidth: S, resizeHeight: S, resizeQuality: RESIZE_QUALITY });
+  try {
+    const ctx = new OffscreenCanvas(S, S).getContext('2d');
+    ctx.drawImage(bitmap, 0, 0);
+    const { data } = ctx.getImageData(0, 0, S, S);
+    return new RawImage(data, S, S, 4).rgb();
+  } finally {
+    bitmap.close();
+  }
+}
